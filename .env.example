POSTGRES_DB="emarket"
POSTGRES_USER="emarket"
POSTGRES_PASSWORD="local-database-password"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://emarket:local-database-password@localhost:5432/emarket?schema=public"
NODE_ENV="development"
PORT="4500"
APP_PORT="3000"
APP_BASIC_AUTH_USER="owner"
APP_BASIC_AUTH_PASSWORD="local-personal-password"

# Only enable this for a disposable, non-production remote database.
# ALLOW_REMOTE_DATABASE_SEED="true"
